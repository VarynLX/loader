--[[
    SIGNAL UI - refreshed UI library
    ------------------------------------------------------------
    API kept familiar to the original UI.lua:
      local UI = require(path.to.UI)
      local window = UI.new("My UI")
      local page = window:addPage("Main")
      local section = page:addSection("General")
      section:addButton("Run", function(updateTitle) end)
      section:addToggle("Enabled", false, function(value, setValue) end)
      section:addTextbox("Name", "", function(value, enterPressed, setValue) end)
      section:addKeybind("Hotkey", Enum.KeyCode.RightShift, function(setValue) end)
      section:addColorPicker("Accent", Color3.fromRGB(126, 139, 255), function(color, setColor) end)
      section:addSlider("Amount", 50, 0, 100, function(value, setValue) end)
      section:addDropdown("Mode", {"First", "Second"}, function(value, setValue) end)

    Intended to run from a LocalScript or ModuleScript in a Roblox client.
    UI objects are parented to the local player's PlayerGui.
]]

