}

local themeObjects = {}
local activeTweens = setmetatable({}, { __mode = "k" })
local globalKeybinds = {}
local dragEndedCallbacks = {}
local inputSystemInitialized = false
local toggleStates = setmetatable({}, { __mode = "k" })

local function isInstance(value)
    return typeof(value) == "Instance"
end

local function registerThemeObject(object, property, color)
    for themeName, themeColor in pairs(themes) do
        if typeof(themeColor) == "Color3" and color == themeColor then
            themeObjects[themeName] = themeObjects[themeName] or {}
            themeObjects[themeName][property] = themeObjects[themeName][property]
                or setmetatable({}, { __mode = "k" })
            themeObjects[themeName][property][object] = true
            break
        end
    end
end

function utility:Find(dictionary, target)
    for key, value in pairs(dictionary) do
        if value == target then
            return key
        end
    end
    return nil
end

function utility:Create(className, properties, children)
    local object = Instance.new(className)

    for property, value in pairs(properties or {}) do
        local ok, err = pcall(function()
            object[property] = value
        end)
        if not ok then
            warn(("[Signal UI] Could not set %s.%s: %s")
                :format(className, tostring(property), tostring(err)))
        elseif typeof(value) == "Color3" then
            registerThemeObject(object, property, value)
        end
    end

    for _, child in pairs(children or {}) do
        if isInstance(child) then
            child.Parent = object
        end
    end

    return object
end

-- Animates each property independently so a colour tween doesn't cancel a
-- simultaneous position or size tween on the same instance.
function utility:Tween(object, properties, duration, ...)
    if not object or not object.Parent and object ~= game then
        return nil
    end

    local extra = table.pack(...)
    local info
    if extra.n == 0 then
        info = TweenInfo.new(
            duration or 0.18,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out
        )
    else
        info = TweenInfo.new(duration or 0.18, table.unpack(extra, 1, extra.n))
    end
