	function library:SelectPage(pg, toggle)
		if toggle and self.focusedPage == pg then
			return
		end
		
		local button = pg.button
		
		if toggle then
			button.Title.TextTransparency = 0
			button.Title.Font = Enum.Font.GothamBold
			
			if button:FindFirstChild("Icon") then
				utility:Tween(button.Icon, {ImageTransparency = 0}, 0.2)
			end

			local highlight = button:FindFirstChild("TabHighlight")
			if highlight then
				utility:Tween(highlight, {BackgroundTransparency = 0}, 0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			end

			local indicator = button:FindFirstChild("Indicator")
			if indicator then
				utility:Tween(indicator, {Size = UDim2.new(0, 3, 0.65, 0)}, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			end
			
			local focusedPage = self.focusedPage
			self.focusedPage = pg
			
			if focusedPage then
				self:SelectPage(focusedPage)
			end
			
			local existingSections = focusedPage and #focusedPage.sections or 0
			local sectionsRequired = #pg.sections - existingSections
			
			pg:Resize()
			
			for i, sec in pairs(pg.sections) do
				sec.container.Parent.ImageTransparency = 0
			end
			
			if sectionsRequired < 0 then
				for i = existingSections, #pg.sections + 1, -1 do
					local sec = focusedPage.sections[i].container.Parent
					utility:Tween(sec, {ImageTransparency = 1}, 0.1)
				end
			end
			
			task.wait(0.08)
			pg.container.Visible = true
			
			if focusedPage then
				focusedPage.container.Visible = false
			end
			
			if sectionsRequired > 0 then
				for i = existingSections + 1, #pg.sections do
					local sec = pg.sections[i].container.Parent
					sec.ImageTransparency = 1
					utility:Tween(sec, {ImageTransparency = 0}, 0.08)
				end
			end
			
			task.wait(0.04)
			
			for i, sec in pairs(pg.sections) do
				utility:Tween(sec.container.Title, {TextTransparency = 0}, 0.12)
				sec:Resize(true)
				task.wait(0.03)
			end
			
			task.wait(0.03)
			pg:Resize(true)
		else
			button.Title.Font = Enum.Font.GothamMedium
			button.Title.TextTransparency = 0.65
			
			if button:FindFirstChild("Icon") then
				utility:Tween(button.Icon, {ImageTransparency = 0.65}, 0.2)
			end

			local highlight = button:FindFirstChild("TabHighlight")
			if highlight then
				utility:Tween(highlight, {BackgroundTransparency = 1}, 0.2)
			end

			local indicator = button:FindFirstChild("Indicator")
			if indicator then
				utility:Tween(indicator, {Size = UDim2.new(0, 3, 0, 0)}, 0.2)
			end
		end
	end
	
	function page:Resize(animate)
		local padding = 10
		local size = 0
		
		for i, sec in pairs(self.sections) do
			size = size + sec.container.Parent.AbsoluteSize.Y + padding
		end
		
		local targetCanvas = UDim2.new(0, 0, 0, size)
		if animate then
			utility:Tween(self.container, {CanvasSize = targetCanvas}, 0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		else
			self.container.CanvasSize = targetCanvas
		end
	end
	
	function section:Resize(animate)
		local padding = 4
		local size = 28
		
		for i, module in pairs(self.modules) do
			size = size + module.AbsoluteSize.Y + padding
		end
		
		local targetSize = UDim2.new(1, -10, 0, size)
		if animate then
			utility:Tween(self.container.Parent, {Size = targetSize}, 0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		else
			self.container.Parent.Size = targetSize
		end
		
		self.page:Resize()
	end
	
	function section:getModule(info)
		if table.find(self.modules, info) then
			return info
		end
		
		for i, module in pairs(self.modules) do
			local textObj = module:FindFirstChild("Title") or module:FindFirstChild("TextBox", true)
			if textObj and textObj.Text == info then
				return module
			end
		end
		
		error("No module found under " .. tostring(info))
	end
	
	function section:updateButton(btn, title)
		btn = self:getModule(btn)
		btn.Title.Text = title
	end
	
	function section:updateToggle(toggle, title, value)
		toggle = self:getModule(toggle)
		
		local position = {
			In = UDim2.new(0, 2, 0.5, -6),
			Out = UDim2.new(0, 20, 0.5, -6)
		}
		
		local frame = toggle.Button.Frame
		local state = value and "Out" or "In"
		
		if title then
			toggle.Title.Text = title
		end
		
		local targetTrackColor = value and (themes.Accent or Color3.fromRGB(0, 200, 120)) or themes.LightContrast
		local targetPillColor = value and themes.TextColor or Color3.fromRGB(180, 180, 180)
		
		utility:Tween(toggle.Button, {ImageColor3 = targetTrackColor}, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		utility:Tween(frame, {ImageColor3 = targetPillColor}, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		
		utility:Tween(frame, {
			Size = UDim2.new(1, -18, 1, -5),
			Position = position[state] + UDim2.new(0, value and -2 or 2, 0, 0)
		}, 0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		
		task.delay(0.08, function()
			if frame and frame.Parent then
				utility:Tween(frame, {
					Size = UDim2.new(1, -22, 1, -4),
					Position = position[state]
				}, 0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			end
		end)
	end
	
	function section:updateTextbox(textbox, title, value)
		textbox = self:getModule(textbox)
		if title then
			textbox.Title.Text = title
		end
		if value then
			textbox.Button.Textbox.Text = value
		end
	end
	
	function section:updateKeybind(keybind, title, key)
		keybind = self:getModule(keybind)
		local text = keybind.Button.Text
		local bind = self.binds[keybind]
		
		if title then
			keybind.Title.Text = title
		end
		
		if bind.connection then
			bind.connection = bind.connection:UnBind()
		end
			
		if key then
			self.binds[keybind].connection = utility:BindToKey(key, bind.callback)
			text.Text = key.Name
		else
			text.Text = "None"
		end
	end
	
	function section:updateColorPicker(colorpicker, title, color)
		colorpicker = self:getModule(colorpicker)
		local picker = self.colorpickers[colorpicker]
		local tab = picker.tab
		
		if title then
			colorpicker.Title.Text = title
			tab.Title.Text = title
		end
		
		local col
		local hue, sat, brightness
		
		if type(color) == "table" then
			hue, sat, brightness = unpack(color)
			col = Color3.fromHSV(hue, sat, brightness)
		else
			col = color
			hue, sat, brightness = Color3.toHSV(col)
		end
		
		utility:Tween(colorpicker.Button, {ImageColor3 = col}, 0.3)
		utility:Tween(tab.Container.Color.Select, {Position = UDim2.new(hue, 0, 0, 0)}, 0.08)
		utility:Tween(tab.Container.Canvas, {ImageColor3 = Color3.fromHSV(hue, 1, 1)}, 0.3)
		utility:Tween(tab.Container.Canvas.Cursor, {Position = UDim2.new(sat, 0, 1 - brightness)}, 0.3)
		
		for i, c in pairs(tab.Container.Inputs:GetChildren()) do
			if c:IsA("ImageLabel") then
				local val = math.clamp(col[c.Name], 0, 1) * 255
				c.Textbox.Text = math.floor(val)
			end
		end
	end
	
	function section:updateSlider(slider, title, value, min, max, lvalue)
		slider = self:getModule(slider)
		if title then
			slider.Title.Text = title
		end
		
		local bar = slider.Slider.Bar
		local percent = (mouse.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
		
		if value then
			percent = (value - min) / (max - min)
		end
		
		percent = math.clamp(percent, 0, 1)
		value = value or math.floor(min + (max - min) * percent)
		
		slider.TextBox.Text = value
		utility:Tween(bar.Fill, {Size = UDim2.new(percent, 0, 1, 0)}, 0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		
		if value ~= lvalue and slider.ImageTransparency == 0 then
			utility:Pop(slider, 6)
		end
		
		return value
	end
	
	function section:updateDropdown(dropdown, title, list, callback)
		dropdown = self:getModule(dropdown)
		
		if title then
			dropdown.Search.TextBox.Text = title
		end
		
		local entries = 0
		utility:Pop(dropdown.Search, 8)
		
		for i, button in pairs(dropdown.List.Frame:GetChildren()) do
			if button:IsA("ImageButton") then
				button:Destroy()
			end
		end
		
		for i, value in pairs(list or {}) do
			local button = utility:Create("ImageButton", {
				Parent = dropdown.List.Frame,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 30),
				ZIndex = 2,
				Image = "rbxassetid://5028857472",
				ImageColor3 = themes.DarkContrast,
				ScaleType = Enum.ScaleType.Slice,
				SliceCenter = Rect.new(2, 2, 298, 298)
			}, {
				utility:Create("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 10, 0, 0),
					Size = UDim2.new(1, -10, 1, 0),
					ZIndex = 3,
					Font = Enum.Font.GothamMedium,
					Text = value,
					TextColor3 = themes.TextColor,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTransparency = 0.15
				})
			})
			
			button.MouseEnter:Connect(function()
				utility:Tween(button, {ImageColor3 = themes.LightContrast}, 0.15)
				local lbl = button:FindFirstChildOfClass("TextLabel")
				if lbl then utility:Tween(lbl, {TextTransparency = 0}, 0.15) end
			end)
			button.MouseLeave:Connect(function()
				utility:Tween(button, {ImageColor3 = themes.DarkContrast}, 0.15)
				local lbl = button:FindFirstChildOfClass("TextLabel")
				if lbl then utility:Tween(lbl, {TextTransparency = 0.15}, 0.15) end
			end)
			
			button.MouseButton1Click:Connect(function()
				utility:Pop(button, 6)
				if callback then
					task.spawn(function()
						callback(value, function(...)
							self:updateDropdown(dropdown, ...)
						end)
					end)
				end
				self:updateDropdown(dropdown, value, nil, callback)
			end)
			
			entries = entries + 1
		end
		
		local frame = dropdown.List.Frame
		local targetHeight = (entries == 0 and 30) or math.clamp(entries, 0, 4) * 34 + 38
		
		utility:Tween(dropdown, {Size = UDim2.new(1, 0, 0, targetHeight)}, 0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		utility:Tween(dropdown.Search.Button, {Rotation = list and 180 or 0}, 0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		
		if entries > 4 then
			for i, button in pairs(dropdown.List.Frame:GetChildren()) do
				if button:IsA("ImageButton") then
					button.Size = UDim2.new(1, -6, 0, 30)
				end
			end
			frame.CanvasSize = UDim2.new(0, 0, 0, (entries * 34) - 4)
			frame.ScrollBarImageTransparency = 0
		else
			frame.CanvasSize = UDim2.new(0, 0, 0, 0)
			frame.ScrollBarImageTransparency = 1
		end
	end
end

return library
